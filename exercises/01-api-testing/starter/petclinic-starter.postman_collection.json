{
  "info": {
    "name": "PetClinic API Testing — Starter",
    "description": "Starter collection for Exercise 01. Request 1 is solved; requests 2-6 are TODOs. Extend me.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9966/petclinic"
    },
    {
      "key": "ownerId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "1 - List all owners (solved example)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/owners",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "owners"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('returns an array', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.be.an('array');",
              "  pm.expect(body.length).to.be.above(0, 'seed data should contain owners');",
              "});",
              "pm.test('responds quickly', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ]
    },
    {
